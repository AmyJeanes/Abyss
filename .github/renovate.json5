{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeDigest",
    ":automergeMinor"
  ],
  "automergeType": "branch",
  "pinDigest": {
    "automerge": true
  },
  "packageRules": [
    {
      // Npgsql's EF Core provider only accepts EF Core of its own major, so they must update together
      "groupName": "EF Core and Npgsql",
      "matchPackageNames": [
        "Microsoft.EntityFrameworkCore*",
        "Npgsql.EntityFrameworkCore.PostgreSQL",
        "dotnet-ef"
      ]
    },
    {
      // Angular limits TypeScript versions so we can't update to latest major/minor automatically
      "matchDepNames": [
        "typescript",
        "@typescript-eslint/*"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      // Always want to use latest version
      "matchDepNames": [
        "ghcr.io/amyjeanes/abyss/abyss.web"
      ],
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "enabled": false
    }
  ]
}
